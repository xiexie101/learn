{
  "nodes": [
    {
      "id": "zhenhuan",
      "name": "甄嬛",
      "actor": "孙俪",
      "desc": "大理寺少卿甄远道长女，由单纯善良的少女历经后宫险恶，最终成为善于谋权、权倾朝野的太后。",
      "still_url": "assets/stills/甄嬛.jpg"
    },
    {
      "id": "emperor",
      "name": "雍正",
      "actor": "陈建斌",
      "desc": "清朝皇帝，城府极深，多疑冷酷。将甄嬛视为纯元皇后的替身，最终被后宫妃嫔联手毒杀。",
      "still_url": "assets/stills/雍正.jpg"
    },
    {
      "id": "empress",
      "name": "皇后",
      "actor": "蔡少芬",
      "desc": "乌拉那拉·宜修，纯元皇后同父异母的妹妹。表面温婉端庄，实则城府极深，精通医理，暗害多名皇嗣，最终被禁足至死。",
      "still_url": "assets/stills/皇后.jpg"
    },
    {
      "id": "huafei",
      "name": "华妃",
      "actor": "蒋欣",
      "desc": "年世兰，大将军年羹尧之妹。性格嚣张跋扈，深爱皇帝，却不知自己不孕是皇帝赐予的“欢宜香”所致，得知真相后撞墙自尽。",
      "still_url": "assets/stills/华妃.jpg"
    },
    {
      "id": "meizhuang",
      "name": "沈眉庄",
      "actor": "斓曦",
      "desc": "甄嬛挚友，人如其名，端庄稳重。初入宫时极受宠，后因“假孕争宠”一案看透皇帝凉薄，对其彻底心死，转而爱上太医温实初。",
      "still_url": "assets/stills/沈眉庄.jpg"
    },
    {
      "id": "anlingrong",
      "name": "安陵容",
      "actor": "陶昕然",
      "desc": "县丞安比槐之女，出身卑微，心思细腻敏感。入宫后遭人欺凌，后投靠皇后，与甄嬛反目成仇，擅长制香与冰嬉，最终食苦杏仁自尽。",
      "still_url": "assets/stills/安陵容.jpg"
    },
    {
      "id": "guojunwang",
      "name": "果郡王",
      "actor": "李东学",
      "desc": "允礼，康熙帝第十七子。风流倜傥，不问政事，一生钟情于甄嬛。最终为了保护甄嬛，自愿饮下皇帝赐予的毒酒而死。",
      "still_url": "assets/stills/果郡王.jpg"
    },
    {
      "id": "wenjian",
      "name": "温实初",
      "actor": "张晓龙",
      "desc": "太医院太医，甄嬛的青梅竹马。一直暗中相助甄嬛与眉庄。为了自证清白挥刀自宫。",
      "still_url": "assets/stills/温实初.jpg"
    }
  ],
